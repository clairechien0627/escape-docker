# Escape Docker — 環境設定範例
# 複製此檔為 .env 並修改 FLAG_SEED

# FLAG 種子：每次改變此值，所有 FLAG 都會重新生成（防止作弊）
FLAG_SEED=escape_docker_2024_change_me

# Scoreboard 管理員密碼
ADMIN_TOKEN=admin_secret_change_me

# Terminal Gateway Port（內部，由 nginx 代理）
TERMINAL_GATEWAY_PORT=3001

# Scoreboard API Port（內部，由 nginx 代理）
SCOREBOARD_PORT=8000
